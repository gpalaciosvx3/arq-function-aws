{
  "name": "arq-serverless-cdk",
  "version": "1.0.0",
  "description": "Arquetipo serverless — NestJS + Lambda + API Gateway + CDK",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"cdk/**/*.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.1",
    "@aws-lambda-powertools/metrics": "^2.33.1",
    "@aws-lambda-powertools/tracer": "^2.33.1",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@middy/core": "^3.6.2",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.37",
    "dotenv": "^16.4.0",
    "esbuild": "^0.21.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.4.0",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@middy/core": "^3.6.2"
  },
  "lint-staged": {
    "{src,test,cdk}/**/*.ts": "prettier --write"
  }
}
